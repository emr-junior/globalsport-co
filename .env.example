# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=3000
# Public URL of the site (used for absolute links)
BASE_URL=http://localhost:3000
# Leave DATABASE_URL empty for local development: an embedded PostgreSQL (PGlite) is stored in DATA_DIR.
# In production use a Supabase/Neon/other PostgreSQL connection string (use the pooled "transaction" URL on serverless).
DATABASE_URL=
DATABASE_SSL=true
DATA_DIR=./.data/pgdata
# Set to 1 when running behind a reverse proxy / PaaS so client IPs are read correctly
TRUST_PROXY=0

# --- Business details (shown in footer/legal pages). Use REAL details. ---
BUSINESS_NAME=GlobalSport Co.
SUPPORT_EMAIL=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
PRIVACY_CONTACT_EMAIL=
# Optional: company registration/tax number - only fill in if real
BUSINESS_REG_NUMBER=

# --- Pricing ---
DISCOUNT_PCT=20
SHIPPING_FLAT_USD=9.99
SHIPPING_FLAT_GBP=7.99
SHIPPING_FLAT_CAD=12.99
FREE_SHIPPING_OVER_USD=150
FREE_SHIPPING_OVER_GBP=120
FREE_SHIPPING_OVER_CAD=200

# --- AI assistant (optional). Provider: Anthropic. Server-side only. ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT=300

# --- Optional analytics (loaded ONLY after the visitor consents). Leave empty to load nothing. ---
ANALYTICS_SCRIPT_URL=

# --- First administrator (used only by `npm run create-admin`, which prompts if these are empty) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
